# The Node process should listen behind Nginx/Caddy, not directly on the internet.
HOST=127.0.0.1
PORT=3000
NODE_ENV=production

# Rotate the credentials that were exposed in the original HTML before using these.
MASSIVE_STOCKS_API_KEY=
MASSIVE_OPTIONS_API_KEY=
MASSIVE_WS_LOGS=false

# Use "none" only for local development. Production requires "sso".
FLOW_AUTH_MODE=sso
FLOW_SSO_SHARED_SECRET=replace-with-at-least-32-random-bytes
FLOW_SSO_ISSUER=php-app
FLOW_SSO_AUDIENCE=spy-flow
PHP_APP_ORIGIN=https://app.example.com
FLOW_PUBLIC_ORIGIN=https://flow.example.com
FLOW_SESSION_TTL_SECONDS=3600
FLOW_SECURE_COOKIES=true

# Safe operational bounds.
MAX_SSE_CLIENTS=100
MAX_SSE_CLIENTS_PER_USER=3
MAX_OPTION_CONTRACTS=1000
MAX_OPTION_CHAIN_PAGES=20
MAX_OPTION_CHAIN_RESULTS=5000
MAX_STRIKE_RANGE=200
UPSTREAM_TIMEOUT_MS=10000
REST_CACHE_MS=2500

